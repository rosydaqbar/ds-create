# 1. OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# 2. Dependencies and build output (web template, examples, app templates)
node_modules/
dist/
web/package/
examples/*/package/
*.tsbuildinfo
*.log

# 2b. Generated by the web template's token build (npm run tokens runs before dev, build and qa). Never read them: read tokens/figma-variables.json.
web/src/tokens/tokens.gen.ts
web/tokens/tokens.dtcg.json
web/src/styles/tokens.css
web/src/styles/chrome.gen.css
web/src/docs/copy.gen.json

# 3. Local QA output
qa-report.json
playwright-report/
test-results/

# 4. Secrets, environment and signing (mostly for app builds)
.env
.env.*
!.env.example
*.local
*.pem
*.p8
*.p12
*.keystore
*.jks
*.mobileprovision
google-services.json
GoogleService-Info.plist

# 5. Per-build working state
ds-create-ledger.json
**/tokens/parts/*.json

# 6. App toolchains (for when the templates are compiled)
**/ios/Pods/
**/ios/build/
**/android/build/
**/android/app/build/
.gradle/
build/
local.properties
*.iml
captures/
.cxx/
.expo/
.build/
.swiftpm/
DerivedData/
xcuserdata/
*.xcuserstate

# 7. Everything a build generates (systems, projects, ledgers, reports). See output/README.md.
output/*
!output/README.md

# 7b. Everything a user provides for a build (briefs, brand files, existing systems, chat notes). See input/README.md.
input/*
!input/README.md

# 8. Agent settings
# Local agent settings and installed skills never go into git. The ds-create skill lives in skills/ds-create/;
# each user links it into .claude/skills/ on their own machine (README, Start here).
.claude/
CLAUDE.local.md

# 9. Local session notes
SESSION.md

# Design hook (impeccable): local settings, never in git.
.impeccable/
